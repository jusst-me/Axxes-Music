# Copy to .env and fill in. Never commit the filled-in file.

# Postgres connection string. Neon provides this; use the pooled connection for the application.
DATABASE_URL=

# Secret used to sign session tokens. Generate one with: pnpm dlx auth secret
AUTH_SECRET=

# Canonical URL of the application. Only needed outside local development.
AUTH_URL=http://localhost:3000

# Origin the canonical and hreflang URLs are built on. On Vercel the production domain is used when
# this is left empty.
NEXT_PUBLIC_SITE_URL=
